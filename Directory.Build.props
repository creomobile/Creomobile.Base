<Project>
	<PropertyGroup>
		<RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<!-- Here rather than in src/ and tests/ separately: those two cover every project
		     that exists today, so the result is unchanged — but the next category of
		     project would have started outside the rule without anyone deciding that. -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!-- Central Package Management pins the versions this code names; it says nothing
		     about what those packages drag in. The lock file records the whole graph, so
		     "the tests were green" names a specific set of libraries rather than whatever
		     resolved that day. It fixes how WE build and test; what the packages publish
		     stays a lower bound, and this file must never become exact ranges in a nuspec.
		     (No double hyphen anywhere in this comment: XML forbids it inside a comment,
		     and MSBuild answers a broken props file by losing every property in it.) -->
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<!-- The lock file above records a content hash for every package, and for one taken
		     from a local folder that hash is of the file sitting on this machine. The SDK
		     registers its own library-packs folder as a restore source, so
		     Microsoft.NET.ILLink.Tasks arrives from whichever SDK is installed instead of from
		     nuget.org. Canonical builds .NET from source and ships its own copy of that
		     package; Microsoft ships a different one. Same version number, different bytes,
		     different hash.

		     Measured on 2026-09-19, and it cost the version number 0.2.6: lock files
		     regenerated on a machine whose .NET comes from apt fail restore in CI, which
		     installs Microsoft's SDK, with NU1403 "the package is different than the last
		     restore". Turning the folder off makes every restore take that package from
		     nuget.org, so the hash recorded here is the feed's and no longer depends on who
		     built the SDK a given machine happens to run. -->
		<DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
		<AdditionalFiles Include="$(RepoRoot)BannedSymbols.txt" />
	</ItemGroup>
</Project>
