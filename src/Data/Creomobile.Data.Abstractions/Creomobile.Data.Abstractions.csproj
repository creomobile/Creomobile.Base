<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Core abstractions for data models: entity base types and timestamp contracts</Description>
		<PackageTags>creomobile;data;abstractions;entities;timestamps</PackageTags>
		<IsAotCompatible>true</IsAotCompatible>
		<!-- Target framework comes from the repository root: net10.0, like every package here.

		     0.2.2 also shipped a net8.0 assembly. It was added on a false premise — that
		     .NET 8 was the current long-term release — when in fact .NET 8 leaves support on
		     2026-11-10 and .NET 10 is the current one. Removing it is formally a breaking
		     change, done in 0.2.3 while 0.2.2 was one day old; CompatibilitySuppressions.xml
		     next to this file is what records it. Do not add a framework back without a
		     consumer who needs it: adding is quiet, removing is not. -->
	</PropertyGroup>
</Project>
