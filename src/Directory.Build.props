<Project>
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
	
	<PropertyGroup>
		<!-- Packages of this repo version in lockstep; bump here for a release. -->
		<Version>0.2.4</Version>
		<!-- Last published version; bump after each release. A new, not yet
		     published package must clear this property in its csproj. -->
		<PackageValidationBaselineVersion>0.2.3</PackageValidationBaselineVersion>
		<!-- A link rather than the text, and static on purpose: what changed in a release is
		     written once in CHANGELOG.md, so this line never goes stale and no package can be
		     published carrying another one's notes. nuget.org shows it under Release Notes. -->
		<PackageReleaseNotes>Changelog: https://github.com/creomobile/Creomobile.Base/blob/master/CHANGELOG.md</PackageReleaseNotes>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
		<Authors>Andrii Glushko</Authors>
		<Company>Creomobile</Company>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>Logo.png</PackageIcon>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/creomobile/Creomobile.Base</RepositoryUrl>
		<PackageProjectUrl>https://github.com/creomobile/Creomobile.Base</PackageProjectUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageTags>creomobile;platform</PackageTags>
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(MSBuildProjectDirectory)\README.md"
			  Pack="true"
			  PackagePath=""/>
		<None Include="$(RepoRoot)Logo.png"
			  Pack="true"
			  PackagePath=""/>
	</ItemGroup>

	<!-- Deliberately no repo-wide InternalsVisibleTo. It used to grant
	     $(AssemblyName).UnitTests and $(AssemblyName).IntegrationTests to every package,
	     including the three that have no internal surface a test touches and the one
	     naming convention that no assembly in this repository has ever used. A package
	     that opens itself to a name nobody holds is an invitation with no addressee, and
	     it travels inside the shipped assembly. Where a test genuinely needs an internal,
	     the package says so itself. -->

</Project>
